# You can use this file to easily send requests to your API.
# Prerequisite: humao.rest-client Vscode plugin (already present on codespace)
# High-level overview of REST API concepts used here: https://www.packtpub.com/en-us/learning/how-to-tutorials/what-are-rest-verbs-and-status-codes-tutorial

# TIP: Run requests in order - later requests reference IDs from earlier responses


# ==========================================
# User Controller Endpoints
# ==========================================

### Get all users
GET http://localhost:8080/api/users

### Create a new user (run this to populate variables for other requests)
# @name createUser
POST http://localhost:8080/api/users
Content-Type: application/json

{
    "name": "Jean Valjean",
    "email": "prisoner3324601@france.fr"
}

### Get user by ID (uses ID from createUser response)
GET http://localhost:8080/api/users/{{createUser.response.body.id}}

### Get user by email (uses email from createUser response)
GET http://localhost:8080/api/users/by-email?email={{createUser.response.body.email}}

### Update user name (PUT)
PUT http://localhost:8080/api/users/{{createUser.response.body.id}}
Content-Type: application/json

{
    "name": "Monsieur Madeleine"
}

### Change user name (PATCH)
PATCH http://localhost:8080/api/users/{{createUser.response.body.id}}/name
Content-Type: application/json

{
    "name": "Monsieur le Maire"
}

### Delete user
DELETE http://localhost:8080/api/users/{{createUser.response.body.id}}

# ==========================================
# Workspace Controller Endpoints
# ==========================================

### Get all workspaces
GET http://localhost:8080/api/workspaces

### Get workspace by id
GET http://localhost:8080/api/workspaces/{{createWorkspace.response.body.id}}

### Create workspace
# @name createWorkspace
POST http://localhost:8080/api/workspaces
Content-Type: application/json

{
    "name": "University Projects",
    "userId": "{{createUser.response.body.id}}"
}

### Create a second user (use this to populate id for the following request) 
# @name createUser2
POST http://localhost:8080/api/users
Content-Type: application/json

{
    "name": "Philip J. Fry",
    "email": "fry@futurama.com"
}

### Add user to workspace
POST http://localhost:8080/api/workspaces/add-user
Content-Type: application/json

{
    "userId": "{{createUser2.response.body.id}}",
    "workspaceId": "{{createWorkspace.response.body.id}}"
}

### Get workspace statistics
GET http://localhost:8080/api/workspaces/statistics/{{createWorkspace.response.body.id}}

### Delete second user
DELETE http://localhost:8080/api/users/{{createUser2.response.body.id}}

# ==========================================
# Document Controller Endpoints
# ==========================================

### Create a new document (run first to populate variables for subsequent requests)
# @name createDocument
POST http://localhost:8080/api/documents
Content-Type: application/json
X-User-Id: {{createUser.response.body.id}}

{
    "title": "Project Charter",
    "content": "This document defines the scope and goals of the project.",
    "workspaceId": "{{createWorkspace.response.body.id}}",
    "ownerId": "{{createUser.response.body.id}}",
    "viewers": [],
    "editors": []
}

### Create a second document
# @name createDocument2
POST http://localhost:8080/api/documents
Content-Type: application/json
X-User-Id: {{createUser.response.body.id}}

{
    "title": "Second Document",
    "content": "This document defines the scope and goals of the project.",
    "workspaceId": "{{createWorkspace.response.body.id}}",
    "ownerId": "{{createUser.response.body.id}}",
    "viewers": [],
    "editors": []
}

### Get the latest version of the document by its documentGroupId
GET http://localhost:8080/api/documents/{{createDocument.response.body.documentGroupId}}

### Update document (creates a new version)
PUT http://localhost:8080/api/documents/{{createDocument.response.body.documentGroupId}}
Content-Type: application/json
X-User-Id: {{createUser.response.body.id}}

{
    "title": "Project Charter v2",
    "content": "Updated scope and goals after review."
}

### Update document - Fail case
PUT http://localhost:8080/api/documents/{{createDocument.response.body.documentGroupId}}
Content-Type: application/json
X-User-Id: {{createUser2.response.body.id}}

{
    "title": "Project Charter v2",
    "content": "Updated scope and goals after review."
}

### Add viewer
PUT http://localhost:8080/api/documents/add-viewer
Content-Type: application/json
X-User-Id: {{createUser.response.body.id}}

{
    "userId": "{{createUser2.response.body.id}}",
    "documentGroupId": "{{createDocument.response.body.documentGroupId}}"
}

### Add viewer - Fail case
PUT http://localhost:8080/api/documents/add-viewer
Content-Type: application/json
X-User-Id: {{createUser2.response.body.id}}

{
    "userId": "{{createUser2.response.body.id}}",
    "documentGroupId": "{{createDocument.response.body.documentGroupId}}"
}

### Get all documents by workspace
GET http://localhost:8080/api/documents/workspace/{{createWorkspace.response.body.id}}

### Get all documents by owner
GET http://localhost:8080/api/documents/owner/{{createUser.response.body.id}}

### Delete all versions of the document
DELETE http://localhost:8080/api/documents/{{createDocument.response.body.documentGroupId}}
X-User-Id: {{createUser.response.body.id}}

### Delete all versions of the document - Fail casse
DELETE http://localhost:8080/api/documents/{{createDocument.response.body.documentGroupId}}
X-User-Id: {{createUser2.response.body.id}}

# ==========================================
# Cleanup (run these last)
# ==========================================

### Delete user
DELETE http://localhost:8080/api/users/{{createUser.response.body.id}}

### Delete second user
DELETE http://localhost:8080/api/users/{{createUser2.response.body.id}}

### Delete all versions of the document
DELETE http://localhost:8080/api/documents/{{createDocument.response.body.documentGroupId}}
X-User-Id: {{createUser.response.body.id}}

### Delete all versions of the second document
DELETE http://localhost:8080/api/documents/{{createDocument2.response.body.documentGroupId}}
X-User-Id: {{createUser.response.body.id}}